#!/bin/sh
# Runs before every commit (switched on by npm install, or npm run hooks): the data against its schemas,
# every model against the model rules, the headless physics tests and the crash test suite. Any failure
# stops the commit (git commit --no-verify skips it, for a work-in-progress commit).
set -e
echo "pre-commit: data (npm run check)"
npm run --silent check
echo "pre-commit: models (npm run check-models)"
npm run --silent check-models -- --quiet
echo "pre-commit: physics tests (npm test)"
npm test --silent
echo "pre-commit: crash test suite (npm run crash-test)"
npm run --silent crash-test
