{
  "name": "@kr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The game's API server (Phase 6): Fastify + TypeScript, PostgreSQL with PostGIS through Drizzle, accounts through Better Auth",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.ts",
    "db:seed": "node src/db/seed.ts",
    "test": "KR_VERIFY_ECONOMY_CACHE=1 node --test --test-concurrency=1 test/*.test.ts",
    "stress:content": "node tools/content-stress.ts",
    "content:import": "node tools/import-content.ts",
    "load-test": "node tools/load-test.ts",
    "load-test:economy": "node tools/economy-load.ts",
    "test:browser": "node tools/accounts-browser.ts",
    "test:browser:economy": "node tools/economy-browser.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@kr/shared": "*",
    "@sentry/node": "^11.4.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.0.15",
    "obscenity": "^0.4.6",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "*",
    "@types/pg": "*",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.11",
    "oauth2-mock-server": "^9.2.0"
  }
}
