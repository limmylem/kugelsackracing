# Copy to server/.env for local development (never commit .env). Every secret the server needs comes from
# the environment: docs/SERVER.md says where each one comes from.
APP_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_URL=postgres://kr:kr@localhost:5432/kr_dev
# 32+ random bytes: openssl rand -base64 32
BETTER_AUTH_SECRET=
# extra origins allowed to call the API with cookies (comma separated); PUBLIC_URL is always allowed
TRUSTED_ORIGINS=
# email: smtp://user:pass@host:port (Gmail: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465);
# Docker Compose's Mailpit: smtp://mailpit:1025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Kugelsack Racing <no-reply@localhost>"
# social login (leave empty to switch one off)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# error tracking (empty: off)
SENTRY_DSN=
# the first admin: this account (once it has signed up and verified its email) gets the admin role at start
ADMIN_EMAIL=
