node_modules/
# the dev server's backups of data files it saved
data/.backup/
# npm run balance-report output
reports/
# models waiting to be imported, and the originals of imported ones (what's imported is in assets/)
incoming/*
!incoming/README.md
.scratch/
.cache/

# built from packages/*/src (npm run build:shared; npm install runs it)
packages/*/dist/
# the server's local files (backups, uploads)
server/.data/

# secrets: never committed (server/.env.example shows what goes in)
.env
.env.*
!.env.example

# the devlog video tool (DEVLOG.md): its output — clips, videos, scripts — and any music you keep next to it.
# Never committed: videos and music are big, and music may not be yours to share.
devlog/out/
devlog/music/
devlog/**/*.mp4
devlog/**/*.webm
devlog/**/*.mov
devlog/**/*.mp3
devlog/**/*.m4a
devlog/**/*.wav
