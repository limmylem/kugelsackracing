{
  "name": "drive-world",
  "private": true,
  "type": "module",
  "description": "Driving game: a real-world Cesium map and three.js test worlds on a Rapier vehicle simulation",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node tests/run.mjs",
    "check": "node tests/check-data.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:all": "node tests/check-data.mjs && node tools/check-models.mjs --quiet && node --test tests/unit/*.test.mjs && node tests/run.mjs && node tests/crash.mjs && node --expose-gc tests/stress.mjs",
    "build:car": "node tools/split-car.mjs",
    "parts": "node tests/parts-report.mjs",
    "check-models": "node tools/check-models.mjs",
    "fix-model": "node tools/fix-model.mjs",
    "import": "node tools/import.mjs",
    "generate-variants": "node tools/generate-variants.mjs",
    "balance-report": "node tools/balance-report.mjs",
    "sample-models": "node tools/sample-models.mjs",
    "guide": "node tools/write-guide.mjs",
    "hooks": "node tools/install-hooks.mjs",
    "prepare": "node tools/install-hooks.mjs && npm run --silent build:shared",
    "icons": "node tools/icons.mjs",
    "playtest": "node tools/playtest.mjs",
    "sounds": "node tools/sounds.mjs",
    "models-todo": "node tools/models-todo.mjs",
    "generate-parts": "node tools/generate-parts.mjs",
    "crash-test": "node tests/crash.mjs",
    "stress": "node --expose-gc tests/stress.mjs",
    "test:audio": "node --expose-gc tests/audio.mjs",
    "test:audio-browser": "node tools/audio-browser.mjs",
    "world:build": "node --max-old-space-size=8192 tools/world/build.mjs",
    "world:bake": "node --max-old-space-size=8192 tools/world/bake.mjs",
    "map:bake": "node --max-old-space-size=12000 map/bake/bake.ts",
    "map:build": "tsc -p tsconfig.render.json && node -e \"require('fs').cpSync('map/vendor','map/build/vendor',{recursive:true})\"",
    "map:typecheck": "tsc -p tsconfig.json",
    "test:map": "node --expose-gc --max-old-space-size=8192 tests/map/map.test.ts",
    "test:world": "node --expose-gc --max-old-space-size=4096 tests/world.mjs",
    "stress:content": "node --expose-gc tests/content-stress.mjs",
    "test:routes": "node --expose-gc --max-old-space-size=8192 tests/map/routes.test.ts",
    "perf:route": "node --expose-gc --max-old-space-size=4096 tests/route-perf.mjs",
    "test:quests": "node --expose-gc --max-old-space-size=8192 tests/map/quests.test.ts",
    "test:npc": "node --expose-gc --max-old-space-size=8192 tests/map/npc.test.ts",
    "economy-sim": "node tools/economy-sim.mjs",
    "validate-content": "node tools/validate-content.mjs",
    "stress:quests": "node --expose-gc --max-old-space-size=8192 tests/quest-stress.mjs",
    "test:newplayer": "node --expose-gc --max-old-space-size=8192 tests/map/newplayer.test.ts",
    "test:tracks": "node tests/tracks.mjs",
    "test:track-drive": "node --expose-gc --max-old-space-size=8192 tests/track-drive.ts",
    "test:dress": "node tests/track-dress.mjs",
    "test:dress-drive": "node --expose-gc --max-old-space-size=8192 tests/track-dress-drive.ts",
    "test:track-events": "node --expose-gc --max-old-space-size=8192 tests/track-events.ts",
    "track-variety": "node tools/track-variety.mjs",
    "test:track-perf": "node --expose-gc --max-old-space-size=4096 tests/track-perf.ts",
    "build:shared": "npm run --workspace @kr/shared build",
    "server": "npm run --workspace @kr/server start",
    "server:dev": "npm run --workspace @kr/server dev",
    "test:server": "npm run --workspace @kr/server test",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "credits": "node tools/credits.mjs",
    "scan-secrets": "node tools/scan-secrets.mjs"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@mapbox/martini": "^0.2.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@stdlib/math-base-special-acos": "^0.2.4",
    "@stdlib/math-base-special-asin": "^0.2.4",
    "@stdlib/math-base-special-atan": "^0.2.4",
    "@stdlib/math-base-special-atan2": "^0.3.1",
    "@stdlib/math-base-special-cos": "^0.3.1",
    "@stdlib/math-base-special-exp": "^0.2.5",
    "@stdlib/math-base-special-hypot": "^0.2.4",
    "@stdlib/math-base-special-ln": "^0.2.5",
    "@stdlib/math-base-special-pow": "^0.3.1",
    "@stdlib/math-base-special-sin": "^0.3.1",
    "@stdlib/math-base-special-tan": "^0.3.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.160.0",
    "esbuild": "^0.28.2",
    "geotiff": "^3.0.5",
    "hyparquet": "^1.31.2",
    "hyparquet-compressors": "^1.1.2",
    "maplibre-gl": "^6.11.2",
    "meshoptimizer": "^0.22.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "sharp": "^0.35.5",
    "three": "0.160.0",
    "typescript": "5.9"
  },
  "workspaces": [
    "packages/*",
    "server"
  ],
  "dependencies": {
    "@colyseus/sdk": "^0.18.5"
  }
}
