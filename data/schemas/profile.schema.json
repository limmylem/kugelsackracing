{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "A player's profile (the save): money, cars, parts and setups",
  "description": "garage/player. Where each part is, is the part's installedOn; each car's setups are saved socket → part maps, one of them the car's active setup.",
  "type": "object",
  "required": ["version", "money", "nextId", "cars", "parts", "currentCar"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "money": { "type": "number", "minimum": 0 },
    "nextId": { "type": "integer", "minimum": 1 },
    "currentCar": { "type": ["string", "null"], "description": "The car being driven / in the garage" },
    "created": { "type": "string" },
    "saved": { "type": "string", "description": "When it was last saved (ISO time)" },
    "hints": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z0-9_]+$" }, "description": "First-time hints seen (garage/hints.js)" },
    "xp": { "type": "integer", "minimum": 0, "description": "All the xp earned (quests): the level is 1 + xp / data/quests.json levels.xpPerLevel" },
    "quests": {
      "type": "object",
      "description": "Each quest played (garage/player/quests.js)",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attempts": { "type": "integer", "minimum": 0 }, "finishes": { "type": "integer", "minimum": 0 }, "dnfs": { "type": "integer", "minimum": 0 },
          "completed": { "type": "boolean" }, "medal": { "enum": ["bronze", "silver", "gold", null] },
          "bestTime": { "type": ["number", "null"] }, "bestScore": { "type": ["number", "null"] },
          "bestSplits": { "type": ["array", "null"], "items": { "type": "number" } }, "bestLaps": { "type": ["array", "null"], "items": { "type": "number" } },
          "paidShare": { "type": "number", "minimum": 0, "maximum": 1, "description": "The share of the quest's reward paid for medals so far" },
          "finishPaid": { "type": "boolean" },
          "recording": { "type": ["string", "null"], "description": "The best run's recording, kept in its own store (quest/recordStore.js)" },
          "lastPlayed": { "type": ["string", "null"] }
        }
      }
    },
    "questLog": { "type": "array", "maxItems": 50, "items": { "type": "object" }, "description": "The last runs handed in: what each paid, and invalid results (paid nothing) with why" },
    "questPending": {
      "type": "object", "required": ["attemptId", "questId", "fee"], "description": "The run under way (its fee paid)",
      "properties": { "attemptId": { "type": "string" }, "questId": { "type": "string" }, "fee": { "type": "number", "minimum": 0 }, "started": { "type": "string" }, "pinkSlip": { "type": "boolean" } }
    },
    "cars": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["carInstanceId", "carId", "setups", "activeSetup"], "additionalProperties": false,
        "properties": {
          "carInstanceId": { "type": "string", "minLength": 1 },
          "carId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "price": { "type": "number", "minimum": 0, "description": "What it cost (its refund if its definition goes)" },
          "damage": {
            "type": "object", "additionalProperties": false, "description": "The body shell's crash damage (garage/damage.js): its condition, its dents (car frame) and the glass and lights broken",
            "properties": {
              "condition": { "type": "number", "minimum": 0, "maximum": 100 },
              "dents": { "$ref": "#/$defs/dents" },
              "broken": { "type": "array", "items": { "type": "string" } }
            }
          },
          "paint": {
            "type": "object", "required": ["colour", "finish"], "additionalProperties": false,
            "properties": { "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "finish": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
          },
          "activeSetup": { "type": ["string", "null"] },
          "setups": {
            "type": "object",
            "additionalProperties": {
              "type": "object", "required": ["setupId", "name", "sockets"], "additionalProperties": false,
              "properties": {
                "setupId": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1, "maxLength": 40 },
                "sockets": { "type": "object", "additionalProperties": { "type": ["string", "null"] }, "description": "Socket → part copy (instance id)" },
                "partIds": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Socket → what part that copy was (to name it if it's been sold)" }
              }
            }
          }
        }
      }
    },
    "parts": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["instanceId", "partId", "condition", "installedOn"], "additionalProperties": false,
        "properties": {
          "instanceId": { "type": "string", "minLength": 1 },
          "partId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "condition": { "type": "number", "minimum": 0, "maximum": 100 },
          "price": { "type": "number", "minimum": 0, "description": "What it cost (its refund if its definition goes)" },
          "tuning": { "type": "object", "additionalProperties": { "type": "number" } },
          "dents": { "$ref": "#/$defs/dents" },
          "damage": {
            "type": "object", "description": "Mechanical damage this copy carries (garage/mechanical.js): numbers, or per corner (FL…) objects of numbers — e.g. a suspension's { FL: { toe, camber, ride, damper } }, a tyre's { pressure, leak }, the engine's { coolant, leak }. A repair clears it",
            "additionalProperties": { "anyOf": [{ "type": "number" }, { "type": "object", "additionalProperties": { "type": "number" } }] }
          },
          "paint": {
            "type": "object", "additionalProperties": false,
            "properties": { "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }, "finish": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
          },
          "installedOn": {
            "anyOf": [
              { "type": "null" },
              { "type": "object", "required": ["car", "socket"], "additionalProperties": false, "properties": { "car": { "type": "string" }, "socket": { "type": "string" } } }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "dents": {
      "type": "array", "maxItems": 64, "description": "Crash dents: where (from the part's socket, car frame), which way it was pushed, and how hard (m/s)",
      "items": { "type": "object", "required": ["p", "d", "s"], "additionalProperties": false, "properties": { "p": { "$ref": "#/$defs/vec3" }, "d": { "$ref": "#/$defs/vec3" }, "s": { "type": "number", "minimum": 0 }, "w": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } } }
    }
  }
}
