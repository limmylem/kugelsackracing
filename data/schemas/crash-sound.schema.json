{
  "$id": "crash-sound.schema.json",
  "title": "Crash sounds (data/sounds/crash.json): the files and how they're played",
  "type": "object",
  "required": ["materials", "impacts", "gain", "pitch", "scrape", "glass", "light"],
  "additionalProperties": false,
  "patternProperties": { "^_": { "type": "string" } },
  "$defs": {
    "file": { "type": "string", "pattern": "^assets/sounds/.+\\.wav$" },
    "takes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } }
  },
  "properties": {
    "materials": { "type": "object", "additionalProperties": { "type": "string" } },
    "impacts": { "type": "object", "additionalProperties": { "type": "object", "required": ["tap", "crunch", "crash"], "additionalProperties": false, "properties": { "tap": { "$ref": "#/$defs/takes" }, "crunch": { "$ref": "#/$defs/takes" }, "crash": { "$ref": "#/$defs/takes" } } } },
    "gain": { "type": "object", "required": ["tap", "crunch", "crash"], "additionalProperties": false, "properties": { "tap": { "$ref": "#/$defs/pair" }, "crunch": { "$ref": "#/$defs/pair" }, "crash": { "$ref": "#/$defs/pair" } } },
    "pitch": { "type": "number", "minimum": 0, "maximum": 0.5 },
    "scrape": { "type": "object", "required": ["files", "gain"], "additionalProperties": false, "properties": { "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/file" } }, "gain": { "type": "number", "minimum": 0 } } },
    "glass": { "type": "object", "required": ["files", "gain"], "additionalProperties": false, "properties": { "files": { "$ref": "#/$defs/takes" }, "gain": { "type": "number", "minimum": 0 } } },
    "light": { "type": "object", "required": ["files", "gain"], "additionalProperties": false, "properties": { "files": { "$ref": "#/$defs/takes" }, "gain": { "type": "number", "minimum": 0 } } },
    "tear": { "type": "object", "required": ["files", "gain"], "additionalProperties": false, "properties": { "files": { "$ref": "#/$defs/takes" }, "gain": { "type": "number", "minimum": 0 } } },
    "clatter": { "type": "object", "required": ["files", "heavyFrom", "gain"], "additionalProperties": false, "properties": { "files": { "type": "object", "required": ["light", "heavy"], "additionalProperties": false, "properties": { "light": { "$ref": "#/$defs/takes" }, "heavy": { "$ref": "#/$defs/takes" } } }, "heavyFrom": { "type": "number", "minimum": 0 }, "gain": { "$ref": "#/$defs/pair" } } },
    "rattle": { "type": "object", "required": ["file", "gain"], "additionalProperties": false, "properties": { "file": { "$ref": "#/$defs/file" }, "gain": { "type": "number", "minimum": 0 } } },
    "synth": { "type": "object", "description": "How npm run sounds makes the files (tools/content/sound.mjs); none for recordings" }
  }
}
