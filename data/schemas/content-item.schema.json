{
  "$id": "content-item.schema.json",
  "title": "A piece of world content: a marker in the world (a quest's start, a point of interest, a spawn point) or a route (the line quests are driven along). content/schema.js checks this (the shape); content/quests.js says in plain words what it still needs.",
  "type": "object",
  "required": [
    "id",
    "version",
    "kind",
    "name",
    "location",
    "status",
    "author",
    "created",
    "updated"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9a-z]{4,40}$"
    },
    "version": {
      "const": 3
    },
    "kind": {
      "enum": [
        "quest",
        "poi",
        "spawn",
        "route"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "icon": {
      "type": "string",
      "pattern": "^[a-z_]{1,32}$"
    },
    "location": {
      "$ref": "#/$defs/place"
    },
    "road": {
      "description": "The road it was snapped to, when it was (snap: the OSM road graph). Null otherwise.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "class": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "enum": [
            "graph",
            "tiles"
          ]
        },
        "segment": {
          "type": [
            "integer",
            "null"
          ]
        },
        "intersection": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "distanceM": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT"
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "sprint",
        "time_trial",
        "checkpoint",
        "drift",
        "delivery",
        "pink_slip"
      ]
    },
    "route": {
      "description": "A quest's route: the id of a content item of kind 'route' (null: none yet).",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^route_[0-9a-z]{4,40}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classes": {
          "description": "Car classes let in (data/classes.json); empty: any.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]$"
          }
        },
        "maxPowerKw": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "minWeightKg": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "maxWeightKg": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "maxKwPerTonne": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "minLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "fee": {
      "description": "Entry fee (the economy's currency).",
      "type": "number",
      "minimum": 0
    },
    "rewards": {
      "description": "Which of the economy's reward tiers (data/economy.json quests.tiers): the money and xp are worked out from it, never stored.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        }
      }
    },
    "npc": {
      "description": "Rivals and traffic (Phase 4 Step 4).",
      "type": "object"
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeOfDay": {
          "enum": [
            "any",
            "dawn",
            "day",
            "dusk",
            "night"
          ]
        },
        "weather": {
          "enum": [
            "any",
            "clear",
            "cloudy",
            "rain",
            "fog"
          ]
        }
      }
    },
    "enabled": {
      "description": "Offered to players once published (off: kept but not offered).",
      "type": "boolean"
    },
    "params": {
      "description": "What this type of quest needs (content/quests.js TYPES).",
      "type": "object"
    },
    "course": {
      "description": "A route's course (route/model.js): its waypoints and road options, and what's worked out from them on the region's road map when it's saved \u2014 the centreline (path), the OSM road segments used (roadData, to notice the map changing), the grid, checkpoints, numbers and problems.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "region",
        "waypoints",
        "options"
      ],
      "properties": {
        "kind": {
          "enum": [
            "p2p",
            "loop"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "waypoints": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "lock": {
                "description": "A road driven end to end: its segment key (way:fromNode:toNode, OSM ids) and the way along it.",
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "key",
                  "dir"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "dir": {
                    "enum": [
                      1,
                      -1
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "offRoad": {
                "type": "boolean"
              }
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reverseOneway": {
              "type": "boolean"
            },
            "motorways": {
              "type": "boolean"
            },
            "unpaved": {
              "type": "boolean"
            },
            "tunnels": {
              "type": "boolean"
            },
            "offRoad": {
              "type": "boolean"
            }
          }
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "startS": {
              "type": [
                "number",
                "null"
              ]
            },
            "adjust": {
              "type": "object"
            },
            "at": {
              "type": [
                "number",
                "null"
              ]
            },
            "finish": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "checkpointMode": {
          "enum": [
            "auto",
            "manual"
          ]
        },
        "spacing": {
          "type": "number",
          "minimum": 0
        },
        "checkpoints": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "s"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "s": {
                "type": "number"
              },
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              },
              "width": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "timeExtension": {
                "type": "number",
                "minimum": 0
              },
              "auto": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "guides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "arrows": {
              "type": "boolean"
            },
            "signs": {
              "type": "boolean"
            },
            "gates": {
              "type": "boolean"
            },
            "arch": {
              "type": "boolean"
            }
          }
        },
        "roads": {
          "description": "Closed to traffic, or open (traffic: Phase 4 Step 4).",
          "enum": [
            "closed",
            "open"
          ]
        },
        "corridor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "margin": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "path": {
          "description": "The centreline, delta-coded (route/geometry.js encodeLine): lat/lon at 1e-6\u00b0, heights in cm, widths in dm.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "n"
              ],
              "properties": {
                "lat": {
                  "type": "string"
                },
                "lon": {
                  "type": "string"
                },
                "h": {
                  "type": "string"
                },
                "w": {
                  "type": "string"
                },
                "v": {
                  "type": "string"
                },
                "t": {
                  "type": "string"
                },
                "n": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "length": {
          "type": "number",
          "minimum": 0
        },
        "stats": {
          "type": [
            "object",
            "null"
          ]
        },
        "referenceTime": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "referenceLine": {
          "description": "The test drive that set the reference time: the line driven and the speed along it.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "n"
              ],
              "properties": {
                "lat": {
                  "type": "string"
                },
                "lon": {
                  "type": "string"
                },
                "h": {
                  "type": "string"
                },
                "w": {
                  "type": "string"
                },
                "v": {
                  "type": "string"
                },
                "t": {
                  "type": "string"
                },
                "n": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "roadData": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "region",
                "version",
                "segments"
              ],
              "properties": {
                "region": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "osmDate": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "segments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "key"
                    ],
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "length": {
                        "type": "number"
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "review": {
          "type": [
            "object",
            "null"
          ]
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "message"
            ],
            "properties": {
              "level": {
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "quest"
          }
        }
      },
      "then": {
        "required": [
          "type",
          "route",
          "entry",
          "fee",
          "rewards",
          "npc",
          "conditions",
          "enabled",
          "params"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "type"
              ]
            },
            {
              "required": [
                "entry"
              ]
            },
            {
              "required": [
                "rewards"
              ]
            },
            {
              "required": [
                "params"
              ]
            },
            {
              "required": [
                "route"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "route"
          }
        }
      },
      "then": {
        "required": [
          "course"
        ]
      },
      "else": {
        "not": {
          "required": [
            "course"
          ]
        }
      }
    }
  ],
  "$defs": {
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon",
        "alt",
        "heading"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt": {
          "description": "Metres above sea level (EGM2008, as the baked world's heights).",
          "type": "number"
        },
        "heading": {
          "description": "Facing, degrees clockwise from north.",
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "altFrom": {
          "description": "What the height came from: the road surface, the ground, the map's terrain, or a guess (no terrain there).",
          "enum": [
            "road",
            "ground",
            "terrain",
            "estimate"
          ]
        }
      }
    }
  }
}
