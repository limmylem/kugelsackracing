{
  "$id": "engine-sound.schema.json",
  "title": "An engine's sound config (data/sounds/engines): the files the game plays for it and how",
  "type": "object",
  "required": ["engine", "cylinders", "layers", "mix", "intake", "shift", "limiter", "damage"],
  "additionalProperties": false,
  "patternProperties": { "^_": { "type": "string" } },
  "$defs": {
    "file": { "type": "string", "pattern": "^assets/sounds/.+\\.wav$" },
    "pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
  },
  "properties": {
    "engine": { "type": "string", "description": "The engine part it's for" },
    "cylinders": { "type": "integer", "minimum": 1 },
    "layers": {
      "type": "array", "minItems": 2, "description": "Loops at rpm points from idle to the redline (in order), each on load and off load",
      "items": { "type": "object", "required": ["band", "rpm", "on", "off"], "additionalProperties": false, "properties": { "band": { "enum": ["idle", "low", "mid", "high", "redline"] }, "rpm": { "type": "number", "exclusiveMinimum": 0 }, "on": { "$ref": "#/$defs/file" }, "off": { "$ref": "#/$defs/file" } } }
    },
    "mix": {
      "type": "object", "required": ["level", "idleLevel", "offLoadLevel", "curve", "load", "toneHz", "maxShift"], "additionalProperties": false,
      "properties": { "blend": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "level": { "type": "number", "minimum": 0 }, "idleLevel": { "type": "number", "minimum": 0, "maximum": 1 }, "offLoadLevel": { "type": "number", "minimum": 0, "maximum": 1 }, "curve": { "type": "number", "exclusiveMinimum": 0 }, "load": { "$ref": "#/$defs/pair" }, "toneHz": { "$ref": "#/$defs/pair" }, "maxShift": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "intake": { "type": "object", "required": ["file", "gain", "hz", "q", "throttle"], "additionalProperties": false, "properties": { "file": { "$ref": "#/$defs/file" }, "gain": { "type": "number", "minimum": 0 }, "hz": { "$ref": "#/$defs/pair" }, "q": { "type": "number", "exclusiveMinimum": 0 }, "throttle": { "$ref": "#/$defs/pair" } } },
    "shift": { "type": "object", "required": ["file", "gain"], "additionalProperties": false, "properties": { "file": { "$ref": "#/$defs/file" }, "gain": { "type": "number", "minimum": 0 } } },
    "limiter": { "type": "object", "required": ["file", "gain", "every"], "additionalProperties": false, "properties": { "file": { "$ref": "#/$defs/file" }, "gain": { "type": "number", "minimum": 0 }, "every": { "type": "number", "minimum": 0 }, "hz": { "type": "number", "minimum": 1, "description": "How often the rev limiter cuts, a second (the bounce)" }, "depth": { "type": "number", "minimum": 0, "maximum": 1, "description": "How far each cut drops the sound" } } },
    "mode": { "enum": ["layers", "granular"], "description": "How the game plays it (audio/dsp.js): the loops crossfaded by the revs, or the sweep's one-cycle grains" },
    "granular": {
      "type": "object", "required": ["on", "off", "grains"], "additionalProperties": false, "description": "The sweep, idle to past the redline, on and off load, and where each engine cycle starts in it (grains: [[start, length (samples), rpm]])",
      "properties": { "on": { "$ref": "#/$defs/file" }, "off": { "$ref": "#/$defs/file" }, "grains": { "type": "string", "pattern": "^assets/sounds/.+\\.json$" }, "step": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 } }
    },
    "exhaust": { "type": "object", "additionalProperties": false, "description": "The engine's own rasp and pops (0..1; the parts' add to them: garage/carSound.js)", "properties": { "rasp": { "type": "number", "minimum": 0, "maximum": 1 }, "pops": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "pops": { "type": "object", "additionalProperties": false, "description": "Crackles on the overrun: from this share of the redline, this loud", "properties": { "from": { "type": "number", "minimum": 0, "maximum": 1 }, "gain": { "type": "number", "minimum": 0 } } },
    "idle": { "type": "object", "additionalProperties": false, "description": "Idling: how far the revs wobble (a share), how quickly; a cammy engine's lope", "properties": { "wobble": { "type": "number", "minimum": 0, "maximum": 0.1 }, "hz": { "type": "number", "exclusiveMinimum": 0 }, "lope": { "type": "number", "minimum": 0, "maximum": 0.2 }, "lopeHz": { "type": "number", "minimum": 0 } } },
    "start": { "type": "object", "additionalProperties": false, "description": "Starting: the starter turns it at crankRpm for `seconds`, then it catches, flaring to flare × idle", "properties": { "crankRpm": { "type": "number", "exclusiveMinimum": 0 }, "seconds": { "type": "number", "exclusiveMinimum": 0 }, "flare": { "type": "number", "minimum": 1 }, "gain": { "type": "number", "minimum": 0 } } },
    "damage": { "type": "object", "required": ["bang", "bangGain", "bent", "bentGain", "rough"], "additionalProperties": false, "properties": { "bang": { "$ref": "#/$defs/file" }, "bangGain": { "type": "number", "minimum": 0 }, "bent": { "$ref": "#/$defs/file" }, "bentGain": { "type": "number", "minimum": 0 }, "rough": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "synth": { "type": "object", "description": "How npm run sounds makes the files (tools/content/sound.mjs); none for real recordings" }
  }
}
