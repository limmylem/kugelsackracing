{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "economy.schema.json",
  "title": "Money in the game: starting money, selling and repairs",
  "type": "object",
  "required": [
    "currency",
    "startingMoney",
    "startingCar",
    "sell",
    "repair"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^_": {
      "type": "string"
    }
  },
  "properties": {
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "startingMoney": {
      "type": "number",
      "minimum": 0
    },
    "startingCar": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "The car a new player has, with its stock parts"
    },
    "sell": {
      "type": "object",
      "required": [
        "ratio"
      ],
      "additionalProperties": false,
      "properties": {
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Of the price, for a part in perfect condition"
        },
        "conditionCurve": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "[condition, factor] points, condition rising"
        },
        "repairShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Of what a copy would cost to put right, taken off its sell value (at most 1: repairing to sell never pays)"
        },
        "floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "A copy sells for at least this share of its worth × ratio"
        }
      },
      "patternProperties": {
        "^_": {
          "type": "string"
        }
      }
    },
    "repair": {
      "type": "object",
      "required": [
        "perPoint",
        "minimum"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^_": {
          "type": "string"
        }
      },
      "properties": {
        "perPoint": {
          "type": "number",
          "minimum": 0,
          "description": "Of the price, for each point of condition put back"
        },
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "breakable": {
          "type": "number",
          "minimum": 0,
          "description": "For each broken window or light the body shell's repair puts back"
        },
        "mechanical": {
          "type": "number",
          "minimum": 0,
          "description": "A part with mechanical damage (garage/mechanical.js): this share of its price to put right (for a system not in systems)"
        },
        "systems": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "description": "Each mechanical system's share of its part's price to put right (a per-wheel one's corner: a quarter)"
        },
        "severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Of a system's repair price, what a slight bit of damage costs (the worst: all of it)"
        },
        "reattach": {
          "type": "number",
          "minimum": 0,
          "description": "Of a part's price, bolting it back on after it came loose or off"
        },
        "maxOfNew": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "A part's repairs together never cost more than this share of a new one"
        },
        "quick": {
          "type": "object",
          "required": [
            "share",
            "condition",
            "dentScale",
            "dentMin",
            "mechanicalKept"
          ],
          "additionalProperties": false,
          "properties": {
            "share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Of the full repair's price"
            },
            "condition": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Condition after (never lower than it was)"
            },
            "dentScale": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Each dent this much as hard after"
            },
            "dentMin": {
              "type": "number",
              "minimum": 0,
              "description": "Dents left shallower than this (m, × their share of the depth) are gone"
            },
            "mechanicalKept": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Bends and wear: this share of what they were (leaks are sealed)"
            }
          }
        }
      }
    },
    "safetyNet": {
      "type": "object",
      "required": [
        "enabled",
        "margin",
        "engineCondition"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^_": {
          "type": "string"
        }
      },
      "description": "The free basic repair for a player who can't afford to make their car drivable (garage/repair.js basicRepair)",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "margin": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Each value put this share of its limit (data/damage.json drivable)"
        },
        "engineCondition": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "raceRewards": {
      "type": "object",
      "patternProperties": {
        "^_": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "description": "Prize money by result (placeholders: what the balance report weighs crash repairs against)"
    },
    "carPrices": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "description": "A new car's price by its class (× the car's priceFactor)"
    },
    "shop": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {
          "type": "string"
        }
      },
      "description": "The shop, dealership and used car lot (garage/shop.js)",
      "properties": {
        "confirmAbove": {
          "type": "number",
          "minimum": 0
        },
        "refund": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minutes"
          ],
          "properties": {
            "minutes": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "garage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slots"
          ],
          "properties": {
            "slots": {
              "type": "integer",
              "minimum": 1
            },
            "slotPrice": {
              "type": "number",
              "minimum": 0
            },
            "growth": {
              "type": "number",
              "minimum": 1
            },
            "maxExtra": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "unlock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "partTiers": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "series": {
                    "type": "string",
                    "pattern": "^series_[0-9a-z]{4,40}$"
                  },
                  "seriesName": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            },
            "carClasses": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "series": {
                    "type": "string",
                    "pattern": "^series_[0-9a-z]{4,40}$"
                  },
                  "seriesName": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              }
            }
          }
        },
        "catalogue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parts": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "price": {
                    "type": "number",
                    "minimum": 0
                  },
                  "hidden": {
                    "type": "boolean"
                  },
                  "unlock": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "level": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "series": {
                        "type": "string",
                        "pattern": "^series_[0-9a-z]{4,40}$"
                      },
                      "seriesName": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  },
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "until": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "maker": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  }
                }
              }
            },
            "cars": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "price": {
                    "type": "number",
                    "minimum": 0
                  },
                  "hidden": {
                    "type": "boolean"
                  },
                  "unlock": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "level": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "series": {
                        "type": "string",
                        "pattern": "^series_[0-9a-z]{4,40}$"
                      },
                      "seriesName": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  },
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "until": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "maker": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  }
                }
              }
            }
          }
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "parts",
              "discount"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "car": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "parts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "minItems": 2,
                "maxItems": 20
              },
              "discount": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "unlock": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "series": {
                    "type": "string",
                    "pattern": "^series_[0-9a-z]{4,40}$"
                  },
                  "seriesName": {
                    "type": "string",
                    "maxLength": 80
                  }
                }
              },
              "hidden": {
                "type": "boolean"
              },
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "until": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "sales": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "starts",
              "ends",
              "discount"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "starts": {
                "type": "string",
                "format": "date-time"
              },
              "ends": {
                "type": "string",
                "format": "date-time"
              },
              "discount": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 0.9
              },
              "all": {
                "type": "boolean"
              },
              "parts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                }
              },
              "cars": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                }
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                }
              },
              "tiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                }
              },
              "classes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "disabled": {
                "type": "boolean"
              }
            }
          }
        },
        "usedLot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 40
            },
            "seed": {
              "type": "string"
            },
            "classes": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "mileage": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "kmPerYear": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "kmPerOwner": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "serviceKm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "wear": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "perKm": {
                  "type": "number",
                  "minimum": 0
                },
                "spread": {
                  "type": "number",
                  "minimum": 0
                },
                "min": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "damage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "maxLoss": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "aftermarket": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 12
                },
                "tiers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "price": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "factor": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "conditionCurve": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "description": "[condition, factor] points, condition rising"
                }
              }
            }
          }
        },
        "makers": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^_": {
              "type": "string"
            }
          },
          "properties": {
            "racing": {
              "type": "string"
            },
            "factory": {
              "type": "string"
            },
            "byCategory": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "parts": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "quests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "perKm",
        "byStars",
        "tiers",
        "byType",
        "byClass",
        "tierOfClass"
      ],
      "properties": {
        "_note": {
          "type": "string"
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "money",
            "xp"
          ],
          "properties": {
            "money": {
              "type": "number",
              "minimum": 0
            },
            "xp": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tier",
              "name",
              "level",
              "feeShare"
            ],
            "properties": {
              "tier": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string"
              },
              "level": {
                "type": "integer",
                "minimum": 1
              },
              "feeShare": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "stakeMaxClass": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "byType": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sprint",
            "time_trial",
            "checkpoint",
            "drift",
            "delivery",
            "pink_slip"
          ],
          "properties": {
            "sprint": {
              "type": "number",
              "minimum": 0
            },
            "time_trial": {
              "type": "number",
              "minimum": 0
            },
            "checkpoint": {
              "type": "number",
              "minimum": 0
            },
            "drift": {
              "type": "number",
              "minimum": 0
            },
            "delivery": {
              "type": "number",
              "minimum": 0
            },
            "pink_slip": {
              "type": "number",
              "minimum": 0
            },
            "circuit_race": {
              "type": "number",
              "minimum": 0
            },
            "hot_lap": {
              "type": "number",
              "minimum": 0
            },
            "hillclimb": {
              "type": "number",
              "minimum": 0
            },
            "endurance": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "byClass": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "fee": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "back": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "roundTo": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "perKm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "money",
            "xp"
          ],
          "properties": {
            "money": {
              "type": "number",
              "minimum": 0
            },
            "xp": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "maxKm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "byStars": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "npc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "perRival": {
              "type": "number",
              "minimum": 0
            },
            "skillFloor": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "tierOfClass": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "farming": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "windowHours",
            "freeRuns",
            "decay",
            "floor"
          ],
          "properties": {
            "windowHours": {
              "type": "number",
              "minimum": 0
            },
            "freeRuns": {
              "type": "integer",
              "minimum": 0
            },
            "decay": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "floor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "_note": {
              "type": "string"
            },
            "stars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "km": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moneyShare",
        "xpShare"
      ],
      "properties": {
        "_note": {
          "type": "string"
        },
        "moneyShare": {
          "type": "number",
          "minimum": 0
        },
        "xpShare": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "simulation": {
      "type": "object",
      "description": "The economy simulation's settings and targets (tools/economy/sim.mjs).",
      "required": [
        "hours",
        "skills",
        "timing",
        "crashes",
        "performance",
        "shopping",
        "pool",
        "targets"
      ]
    },
    "trackEvents": {
      "type": "object",
      "description": "Track events' rewards (Phase 5 Step 3): by kind of track, farming per track code, the quick races' hourly cap.",
      "additionalProperties": false,
      "required": [
        "byKind",
        "farming",
        "hourlyCap"
      ],
      "properties": {
        "_note": {
          "type": "string"
        },
        "byKind": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "official",
            "daily",
            "weekly",
            "quick",
            "shared"
          ],
          "properties": {
            "official": {
              "type": "number",
              "minimum": 0
            },
            "daily": {
              "type": "number",
              "minimum": 0
            },
            "weekly": {
              "type": "number",
              "minimum": 0
            },
            "quick": {
              "type": "number",
              "minimum": 0
            },
            "shared": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "farming": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "windowHours",
            "freeRuns",
            "decay",
            "floor"
          ],
          "properties": {
            "windowHours": {
              "type": "number",
