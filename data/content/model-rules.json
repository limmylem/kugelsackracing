    "track": [1.1, 1.9],
    "groundTolerance": 0.05,
    "wheelHeightTolerance": 0.015,
    "wheelRadius": [0.24, 0.42],
    "mirrorTolerance": 0.01,
    "triangles": 25000,
    "paintMaterial": "paint",
