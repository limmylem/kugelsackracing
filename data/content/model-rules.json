    "expectedSockets": ["socket_bonnet", "socket_boot", "socket_bumper_front", "socket_bumper_rear", "socket_door_left", "socket_door_right", "socket_fender_FL", "socket_fender_FR", "socket_skirt_left", "socket_skirt_right", "socket_mirror_left", "socket_mirror_right", "socket_seat_driver", "socket_seat_passenger", "socket_steering_wheel", "socket_engine", "socket_intake", "socket_turbo", "socket_exhaust_tip", "socket_spoiler"],
