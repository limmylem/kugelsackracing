      },
      "stats": {
        "boost": { "label": "peak boost", "unit": "bar", "formula": "0.35 + (size - 40) * 0.024", "range": [0.3, 1.3], "digits": 2 },
        "spoolRpm": { "label": "half boost at", "unit": "rpm", "formula": "round(1900 + (size - 40) * 55 + (ar - 0.6) * 1600, 50)", "range": [1500, 6000] },
        "fullRpm": { "label": "full boost at", "unit": "rpm", "formula": "round(spoolRpm + 900 + (size - 40) * 20, 50)", "range": [2500, 7000] },
        "torqueGain": { "label": "torque added at full boost", "unit": "%", "formula": "boost * 0.85 / 1.01325", "range": [0.2, 0.85], "digits": 3 },
        "mass": { "label": "mass", "unit": "kg", "formula": "8 + (size - 40) * 0.35 + ar * 4", "range": [6, 30], "digits": 1 },
        "whistleLow": { "label": "whistle from", "unit": "Hz", "formula": "round(2600 - (size - 40) * 20, 50)", "range": [1200, 3200] },
        "whistleHigh": { "label": "whistle to", "unit": "Hz", "formula": "round(8800 - (size - 40) * 70, 50)", "range": [4500, 9500] }
      },
