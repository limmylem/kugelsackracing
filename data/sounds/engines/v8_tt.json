        "hz": [110, 150],
        "q": 1.2,
        "gain": [0.5, 0.35],
        "offLoad": 0.45
      },
      {
        "name": "tone",
        "hz": [380, 760],
        "q": 1.5,
        "gain": [1.6, 1],
        "offLoad": 1
      },
      {
        "name": "rasp",
        "hz": [1400, 2800],
        "q": 1.3,
        "gain": [0.7, 1.2],
        "offLoad": 0.2
      },
      {
        "name": "edge",
        "hz": [3500, 5200],
        "q": 2,
        "gain": [0.2, 0.6],
        "offLoad": 0.03
      }
    ],
    "clip": [0.5, 2.8],
    "tone": [2600, 11000],
    "rms": 0.21,
    "offLoad": {
