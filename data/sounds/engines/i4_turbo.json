  "synth": {
    "_note": "How npm run sounds makes the files (tools/content/sound.mjs). Pairs are [at idle, at the redline] (a layer's place between them by log rpm). Each firing: a pressure pulse (pulseRise, pulseDecay s, shorter up high) and combustion noise (noise × the pulse, noiseDecay s), cylinder to cylinder a little different (cylinders) and a little early or late (jitter, share of the gap); through the exhaust's resonances (band-passes: hz, q, gain on load, offLoad), plus direct × the raw pulse; high-passed at highpass Hz, driven into a soft clip (clip), low-passed at tone Hz; rms: the loop's level. Off load: the pulses × offLoad.pulse, some burble (random ± share per firing), its own noise, clip and tone.",
    "seed": 21,
    "sampleRate": 32000,
    "length": 0.9,
    "cylinders": [1, 0.94, 0.97, 0.92],
    "jitter": 0.02,
    "pulseRise": 0.0003,
    "pulseDecay": 0.0018,
    "noiseDecay": 0.0016,
    "noise": [0.2, 0.55],
    "direct": 0.2,
    "highpass": 35,
    "resonances": [
      {
        "name": "boom",
        "hz": [95, 125],
        "q": 1.2,
        "gain": [0.65, 0.5],
        "offLoad": 0.55
      },
      {
        "name": "tone",
        "hz": [260, 480],
        "q": 1.4,
        "gain": [1.8, 1.3],
        "offLoad": 1.1
      },
      {
        "name": "rasp",
        "hz": [1000, 1800],
        "q": 1.3,
        "gain": [0.3, 0.5],
        "offLoad": 0.12
      },
      {
        "name": "edge",
        "hz": [2600, 3600],
        "q": 2,
        "gain": [0.05, 0.15],
        "offLoad": 0.02
      }
    ],
    "clip": [0.3, 1.6],
    "tone": [1800, 5200],
    "rms": 0.2,
    "offLoad": {
      "pulse": 0.4,
      "burble": 0.3,
      "noise": 0.06,
      "clip": 0.2,
      "tone": [1200, 3200]
    }
  }
}
