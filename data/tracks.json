  "build": {
    "_note": "The road and the ground (track/build.js). step: m between cross-sections of the road mesh. verge: m of flat run-off either side, the same height as the road's edge, left for kerbs and barriers (Phase 5 Step 2). margin: m of ground round the track. cell: the ground grid's spacing (m, at least; bigger tracks: bigger cells, at most maxCells across). blend: m over which the ground meets the land round it. Version-2 tracks: the run-off, kerbs and barriers come from the dressing (track/dress.js); kerb: the flat kerb's width and height (m), its ridges' spacing, the sausage kerb's; runoffFall: how steeply run-off falls away from the road's edge; lip: m of verge beyond the kerbs' width before the run-off (its gravel, grass) begins.",
    "step": 2,
    "verge": 5,
    "margin": 260,
    "cell": 4,
    "maxCells": 420,
    "blend": 55,
    "kerb": {
      "width": 1.2,
      "height": 0.035,
      "ridge": 0.9,
      "sausageWidth": 0.5,
      "sausageHeight": 0.11
    },
    "runoffFall": 0.02,
    "lip": 1.5
  },
