{
  "id": "ecu_standalone",
  "name": "Standalone ECU (forced induction, adjustable)",
  "category": "ecu",
  "slot": "ecu",
  "kind": "modifier",
  "price": 1600,
  "mass": 1,
  "model": "",
  "icon": "assets/icons/parts/ecu_standalone.png",
  "fits": [],
  "requires": [
    ["slot:turbo", "slot:supercharger", "induction:turbo"]
  ],
  "conflicts": [],
  "provides": [],
  "_note": "A programmable engine computer for a turbo engine: its own ignition and fuel maps (6% more torque from 2500 rpm), the rev limit (the automatic shifts 100 rpm under it) and the boost target — as much as the fitted turbo can make as it comes, which the tuning can turn down.",
  "effects": [
    {
      "target": "engine.torqueCurve",
      "op": "multiply",
      "value": 1.06,
      "when": {
        "rpm": [2500, 7200],
        "fade": 500
      }
    }
  ],
  "tuning": {
    "revRaise": {
      "label": "rev limit",
      "unit": "rpm",
      "min": -500,
      "max": 400,
      "step": 100,
      "default": 200,
      "apply": [
        {
          "target": "engine.redlineRpm",
          "op": "add"
        },
        {
          "target": "gearbox.auto.upFull",
          "op": "add"
        },
        {
          "target": "gearbox.maxDownshiftRpm",
          "op": "add"
        }
      ]
    },
    "boostTarget": {
      "label": "boost target",
      "unit": "bar",
      "min": 0.3,
      "max": 0.85,
      "step": 0.05,
      "default": 0.85,
      "apply": [
        {
          "op": "boostPeak"
        }
      ]
    }
  },
  "tier": "race"
}
