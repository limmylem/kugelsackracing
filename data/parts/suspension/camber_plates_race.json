  "mass": 3,
  "model": "",
  "icon": "assets/icons/parts/camber_plates_race.png",
  "fits": [
    ["chassis:starter", "suspension_mount:std"]
  ],
  "requires": [],
  "conflicts": [],
  "provides": [],
  "_note": "Adjustable top mounts and rear arms: a much wider range of camber, front and rear (Tuning), from a road car's lean to a slammed show car's. About −2° is the most cornering grip (physics/vehicle.js #camber); past it the tyres grip less every way, and every degree costs braking and traction. The wheels lean as set, in the garage and on the road.",
  "effects": [],
  "tuning": {
    "front": {
      "label": "front camber",
      "unit": "°",
      "min": -6,
      "max": 1.5,
      "step": 0.1,
      "default": -2,
      "apply": [
        {
          "target": "suspension.camber.front",
          "op": "add"
        }
      ]
    },
    "rear": {
      "label": "rear camber",
      "unit": "°",
      "min": -5,
      "max": 1.5,
      "step": 0.1,
      "default": -1.5,
      "apply": [
        {
          "target": "suspension.camber.rear",
          "op": "add"
        }
      ]
    }
  },
  "tier": "sport"
}
