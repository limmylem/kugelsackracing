          "target": "suspension.stiffness",
          "op": "multiply",
          "scale": 0.01
        }
      ]
    },
    "dampers": {
      "label": "damping",
      "unit": "%",
      "min": 50,
      "max": 160,
      "step": 5,
      "default": 100,
      "apply": [
        {
          "target": "suspension.damping",
          "op": "multiply",
          "scale": 0.01
