{
  "_note": "Map v3's bake settings (MAP_README.md). Bump version after changing anything: the next bake redoes every tile and the game's tile cache drops the old ones.",
  "version": 1,
  "roads": {
    "_note": "densify: m between points added on curves (never moving OSM's own nodes); corner: a turn sharper than this (\u00b0) stays a corner; smooth: the height profile's Gaussian (m); median: points either side in the spike filter; camber: crossfall from the crown; skirt / skirtDrop: how far past its edge a road dips under the ground; markings; minJunctionCut: m a road stops short of a junction beyond its width",
    "densify": 5,
    "corner": 40,
    "smooth": 12,
    "median": 2,
    "camber": 0.02,
    "skirt": 0.6,
    "skirtDrop": 0.3,
    "markingWidth": 0.12,
    "dash": 3,
    "gap": 6,
    "minJunctionCut": 1.0
  },
  "terrain": {
    "_note": "sink: the ground under a road, below its surface (m); core: m past the road's edge still flat; slope: cuttings and embankments, horizontal per vertical; maxBlend: the most they spread (m); bridgeClearance: the ground kept this far below a deck; tunnelCover: ground this much over a tunnel is its roof; waterDepth: ground under water; parkingMargin: m a car park slopes back over; lodErrors: the terrain meshes' levels of detail (RTIN error, m)",
    "sink": 0.06,
    "core": 0.5,
    "slope": 1.6,
    "maxBlend": 18,
    "bridgeClearance": 0.4,
    "tunnelCover": 5,
    "waterDepth": 0.8,
    "parkingMargin": 5,
    "lodErrors": [
      0.04,
      0.5,
      3
    ],
    "rockSlope": 0.9
  },
