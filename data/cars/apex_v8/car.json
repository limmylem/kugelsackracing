    "referenceOffset": 40,
    "maxTyreRadius": 0.367
  },
  "steering": {
    "_note": "ratio: steering wheel angle ÷ front wheel angle; maxWheelRotation: steering wheel lock to lock (degrees), so the front wheels turn up to (maxWheelRotation/2) ÷ ratio. Keyboard / gamepad: the front wheels' reach shrinks with speed (falloffSpeed) and they move at rate / returnRate rad/s, slower at speed (rateFalloffSpeed); a gamepad steers gamepadRateScale × faster. A steering wheel goes straight through. ackermann: 1 = the inside wheel turns enough for both to roll round the same centre.",
    "ratio": 12.5,
    "maxWheelRotation": 900,
    "falloffSpeed": 28,
    "rate": 2.6,
    "rateFalloffSpeed": 30,
    "returnRate": 4,
    "gamepadRateScale": 2.5,
    "ackermann": 1,
    "counterSteer": {
      "_note": "Countersteer assist (keyboard / gamepad): as the rear axle starts sliding sideways (fading in from slideFrom to slideTo radians) the front wheels may turn as far as it takes to point where the car is going (zero front slip angle, where the self-aligning torque pulls them), faster (rate), and with no steering input they go there on their own.",
