      "slideTo": 0.3,
      "margin": 0.06,
      "rate": 4,
      "minSpeed": 3
    },
    "selfAligning": {
      "_note": "Self-aligning torque at the front wheels = side force × trail. Pneumatic trail shrinks from pneumaticTrail (m) to nothing at trailZeroAtPeak × the tyre's peak slip angle, so the steering goes light as the front loses grip; mechanicalTrail (caster, m) stays. ffbFullScale: torque (N·m, at the kingpins) that gives full force feedback.",
      "pneumaticTrail": 0.035,
      "trailZeroAtPeak": 1.3,
      "mechanicalTrail": 0.012,
      "ffbFullScale": 160
    }
  },
